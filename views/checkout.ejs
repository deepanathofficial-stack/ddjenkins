<%- include('partials/header') %>

<h1 class="page-title">Checkout</h1>

<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<div class="checkout-layout">
  <form action="/checkout" method="POST">
    <h3>Shipping Information</h3>
    <div class="form-grid">
      <div class="form-group full">
        <label>Full Name</label>
        <input type="text" name="fullName" required />
      </div>
      <div class="form-group full">
        <label>Email</label>
        <input type="email" name="email" required />
      </div>
      <div class="form-group full">
        <label>Address</label>
        <input type="text" name="address" required />
      </div>
      <div class="form-group">
        <label>City</label>
        <input type="text" name="city" required />
      </div>
      <div class="form-group">
        <label>ZIP Code</label>
        <input type="text" name="zip" required />
      </div>
    </div>

    <h3>Payment (demo only — not processed)</h3>
    <div class="form-grid">
      <div class="form-group full">
        <label>Card Number</label>
        <input type="text" name="cardNumber" placeholder="4242 4242 4242 4242" required />
      </div>
      <div class="form-group">
        <label>Expiry</label>
        <input type="text" name="expiry" placeholder="MM/YY" />
      </div>
      <div class="form-group">
        <label>CVC</label>
        <input type="text" name="cvc" placeholder="123" />
      </div>
    </div>

    <button type="submit" class="btn btn-primary btn-block">Place Order — $<%= cart.total.toFixed(2) %></button>
  </form>

  <div class="order-summary">
    <h3>Order Summary</h3>
    <% cart.items.forEach(function(item) { %>
      <div class="line">
        <span><%= item.product.name %> × <%= item.qty %></span>
        <span>$<%= item.subtotal.toFixed(2) %></span>
      </div>
    <% }) %>
    <div class="line grand-total">
      <span>Total</span>
      <span>$<%= cart.total.toFixed(2) %></span>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
