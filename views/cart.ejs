<%- include('partials/header') %>

<h1 class="page-title">Your Cart</h1>

<% if (cart.items.length === 0) { %>
  <div class="empty-state">
    <p>Your cart is empty.</p>
    <a href="/" class="btn btn-primary">Continue Shopping</a>
  </div>
<% } else { %>
  <table class="cart-table">
    <thead>
      <tr>
        <th>Product</th>
        <th>Price</th>
        <th>Quantity</th>
        <th>Subtotal</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% cart.items.forEach(function(item) { %>
        <tr>
          <td>
            <a href="/product/<%= item.product.id %>" class="cart-item-name">
              <img src="<%= item.product.image %>" alt="<%= item.product.name %>" />
              <%= item.product.name %>
            </a>
          </td>
          <td>$<%= item.product.price.toFixed(2) %></td>
          <td>
            <form action="/cart/update/<%= item.product.id %>" method="POST" style="display:flex; gap:8px; align-items:center;">
              <input type="number" name="qty" value="<%= item.qty %>" min="1" max="<%= item.product.stock %>" />
              <button type="submit" class="btn btn-secondary btn-sm">Update</button>
            </form>
          </td>
          <td>$<%= item.subtotal.toFixed(2) %></td>
          <td>
            <form action="/cart/remove/<%= item.product.id %>" method="POST">
              <button type="submit" class="btn btn-danger btn-sm">Remove</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="cart-summary">
    <span class="total">Total: $<%= cart.total.toFixed(2) %></span>
    <a href="/checkout" class="btn btn-primary">Proceed to Checkout</a>
  </div>
<% } %>

<%- include('partials/footer') %>
